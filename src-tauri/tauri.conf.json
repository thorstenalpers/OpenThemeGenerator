{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "OpenThemeGenerator",
	"version": "0.1.0",
	"identifier": "com.thorstenalpers.openthemegenerator",
	"build": {
		"beforeDevCommand": "npm run dev",
		"devUrl": "http://localhost:5178",
		"beforeBuildCommand": "npm run build",
		"frontendDist": "../build"
	},
	"app": {
		"windows": [
			{
				"title": "OpenThemeGenerator",
				"width": 1280,
				"height": 860,
				"minWidth": 940,
				"minHeight": 620
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "nsis",
		"icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
		"windows": {
			"nsis": {
				"installerIcon": "icons/icon.ico",
				"uninstallerIcon": "icons/icon.ico"
			}
		},
		"createUpdaterArtifacts": true
	},
	"plugins": {
		"updater": {
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEExNTQ1MjE2MzE1NDM1NDUKUldSRk5WUXhGbEpVb1o0Z0tFUjJOT3Z5bmwzR1ZybzFYelNETHVIbjVnM29Ob1FDM2x0QWI0RDgK",
			"endpoints": [
				"https://github.com/thorstenalpers/OpenThemeGenerator/releases/latest/download/latest.json"
			],
			"windows": {
				"installMode": "passive"
			}
		}
	}
}
